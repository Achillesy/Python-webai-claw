{
  "manifest_version": 3,
  "name": "webai-claw",
  "version": "1.1.7",
  "description": "Run local commands and upload files from DeepSeek or Muse chats via a user-installed native host.",
  "homepage_url": "https://github.com/Achillesy/Python-webai-claw",
  "action": {
    "default_popup": "popup.html",
    "default_title": "webai-claw"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "adapters/muse.js",
        "adapters/deepseek.js",
        "content.js"
      ],
      "matches": [
        "https://muse.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://muse.ai/*",
    "https://chat.deepseek.com/*"
  ],
  "permissions": [
    "nativeMessaging",
    "storage",
    "notifications"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
